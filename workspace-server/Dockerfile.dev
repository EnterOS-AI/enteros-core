# Dockerfile.dev — local-development image with air-driven live reload.
#
# Selected by docker-compose.dev.yml (overlay over docker-compose.yml).
# Production stays on workspace-server/Dockerfile (static binary, no air).
#
# Workflow:
#   1. docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#   2. Edit any .go file under workspace-server/
#   3. air detects, rebuilds, kills old binary, starts new one (~3-5s)
#   4. No `docker compose up --build` needed
#
# Templates + plugins are NOT pre-cloned here — air-mode assumes the
# developer's filesystem has the workspace-configs-templates/ + plugins/
# dirs available, mounted at runtime via docker-compose.dev.yml.

# Base images come from OUR registry, not Docker Hub.
#
# WHY: Hub's ANONYMOUS pull limit (~100/6h per IP) is shared by every CI job on
# the runner and we hold NO Hub credentials. When it is spent, EVERY open PR
# reds at once on `429 Too Many Requests ... /v2/library/...` — a failure with
# no relationship to any PR's diff. registry.moleculesai.app mirrors these and
# has no such limit.
#
# The digests below are the MIRROR's, and for most images they DIFFER from the
# Hub digest they replace. That is not a content change: `docker push` of a
# single-platform image re-wraps the manifest, so the digest of the WRAPPER
# moves while every layer digest stays identical. A Hub digest that happens to
# name a child manifest (golang, node:20, nginx) survives verbatim; one that
# named Hub's multi-arch INDEX (alpine, node:22, python) cannot, and had to be
# re-pinned. Do not "restore" the Hub digests — they do not exist in the mirror.
#
# Override (e.g. to refresh the mirror from upstream):
#   --build-arg BASE_IMAGE_REGISTRY=docker.io/library
ARG BASE_IMAGE_REGISTRY=registry.moleculesai.app/molecule-ai
# Full base reference, overridable as a UNIT (registry AND digest together) —
# the digest below is mirror-specific and does not exist on Docker Hub, so
# swapping only BASE_IMAGE_REGISTRY cannot resolve.
#
# ARM64 NOTE: the mirrored golang image is amd64-only. Unlike the alpine mirror
# (an OCI index that lists ONLY linux/amd64, which buildx rejects outright with
# "no match for platform in manifest"), this one is a bare manifest, so Docker
# accepts it on an arm64 host and the container runs under EMULATION — it
# builds and works, just slowly, and `uname -m` inside reports x86_64.
#
# To build natively on Apple Silicon:
#   docker build \
#     --build-arg BASE_IMAGE_REGISTRY=docker.io/library \
#     --build-arg GOLANG_BASE=golang:1.25-alpine \
#     -f workspace-server/Dockerfile.dev .
ARG GOLANG_BASE=golang:1.25-alpine@sha256:c4ea15b4a7912716eb362a022e2b12317762eca387423760bc59c0f9ae69423c
FROM ${BASE_IMAGE_REGISTRY}/${GOLANG_BASE}

# air + git (for go mod) + ca-certs (for TLS) + tzdata (for time-zone DB)
# + docker-cli + docker-cli-buildx so the platform binary can shell out to
# /var/run/docker.sock (bind-mounted from host) for local-build provisioning.
# docker-cli alone is insufficient: alpine's docker-cli enables BuildKit by
# default but ships without buildx, producing
# `ERROR: BuildKit is enabled but the buildx component is missing or broken`
# on every `docker build`. docker-cli-buildx provides the buildx subcommand.
# AIR IS PINNED, NOT @latest — do not "modernise" this back.
#
# air v1.67.2+ declares `go 1.26.0` in its go.mod. This base image is
# golang:1.25-alpine and ships GOTOOLCHAIN=local, so there is no toolchain
# auto-upgrade to rescue it: `go install air@latest` fails with
#
#   github.com/air-verse/air@v1.67.3 requires go >= 1.26.0
#     (running go 1.25.12; GOTOOLCHAIN=local)
#
# and `go install` exits 1, so the IMAGE BUILD FAILS — which is exactly what
# `make dev` was doing for everyone. v1.67.1 is the last release that still
# declares `go 1.25`.
#
# When the base image moves to 1.26+, this pin can go back to @latest (or a
# newer pin). Note the base is digest-pinned against a private mirror, so
# bumping it is a separate change — see the BASE_IMAGE_REGISTRY note above.
RUN apk add --no-cache git ca-certificates tzdata wget docker-cli docker-cli-buildx \
 && go install github.com/air-verse/air@v1.67.1

WORKDIR /app/workspace-server

# Pre-fetch deps so the first `air` rebuild on a fresh container is fast.
# These are bind-mount-overridden at runtime, so the COPY here is just
# to warm the module cache.
COPY workspace-server/go.mod workspace-server/go.sum ./
RUN go mod download

# Source is bind-mounted at runtime (see docker-compose.dev.yml volumes
# block) so the Dockerfile doesn't need to COPY it. air watches the
# bind-mounted dir for changes.

ENV CGO_ENABLED=0
ENV GOFLAGS="-buildvcs=false"

# Run air with the .air.toml in the bind-mounted source dir.
CMD ["air", "-c", ".air.toml"]
